# Copy this file to `keystore.properties` (which is gitignored) and fill in real values to build a
# signed release APK locally:  ./gradlew :androidApp:assembleRelease
#
# In CI these are provided as environment variables instead (see .github/workflows/release.yml):
#   storeFile      -> YAMA_KEYSTORE_FILE
#   storePassword  -> YAMA_KEYSTORE_PASSWORD
#   keyAlias       -> YAMA_KEY_ALIAS
#   keyPassword    -> YAMA_KEY_PASSWORD
#
# Generate a keystore once with (keep the resulting .jks + these passwords backed up safely —
# losing them means you can never ship an update that upgrades an already-installed copy):
#
#   keytool -genkeypair -v -keystore yama-release.jks -alias yama \
#           -keyalg RSA -keysize 4096 -validity 10000

storeFile=yama-release.jks
storePassword=CHANGE_ME
keyAlias=yama
keyPassword=CHANGE_ME
