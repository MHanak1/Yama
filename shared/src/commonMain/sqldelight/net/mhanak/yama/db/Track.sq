-- The offline track index: every locally-indexed track, partitioned by `sourceKey` ("local" for the
-- on-device scan, "jellyfin:<token>" for downloads). Replaces the JSON `FileLibraryStore` so writes are
-- incremental (one row, not a whole-file rewrite) and lookups/searches are indexed. List-valued and
-- enum/boolean fields are stored as TEXT/INTEGER and (de)serialised in SqlLibraryStore — the schema
-- stays free of column adapters.

CREATE TABLE trackRow (
    sourceKey TEXT NOT NULL,
    id TEXT NOT NULL,
    path TEXT NOT NULL,
    title TEXT NOT NULL,
    albumId TEXT,
    album TEXT,
    albumArtist TEXT,
    albumArtistId TEXT,
    artists TEXT NOT NULL,        -- JSON array
    artistIds TEXT NOT NULL,      -- JSON array
    genres TEXT NOT NULL,         -- JSON array
    genreIds TEXT NOT NULL,       -- JSON array
    trackNumber INTEGER,
    discNumber INTEGER,
    durationMs INTEGER,
    year INTEGER,
    artworkPath TEXT,
    lastModified INTEGER NOT NULL,
    hasMetadata INTEGER NOT NULL, -- 0/1
    retention TEXT NOT NULL,      -- Retention enum name
    quality TEXT,                 -- StreamingQuality enum name
    originVersion TEXT,
    downloadedAt INTEGER,
    lastPlayedAt INTEGER,
    stale INTEGER NOT NULL,       -- 0/1
    sizeBytes INTEGER NOT NULL,
    favorite INTEGER NOT NULL DEFAULT 0,  -- 0/1; the user's liked state, kept offline (see FavoriteOutbox)
    playCount INTEGER NOT NULL DEFAULT 0, -- local play tally, bumped on completed play so offline sort-by-plays works
    PRIMARY KEY (sourceKey, id)
);

CREATE INDEX trackRow_sourceKey ON trackRow(sourceKey);
CREATE INDEX trackRow_album ON trackRow(sourceKey, albumId);
CREATE INDEX trackRow_title ON trackRow(sourceKey, title);

allForSource:
SELECT * FROM trackRow WHERE sourceKey = ? ORDER BY rowid;

getById:
SELECT * FROM trackRow WHERE id = ? LIMIT 1;

getByKey:
SELECT * FROM trackRow WHERE sourceKey = ? AND id = ?;

upsert:
INSERT OR REPLACE INTO trackRow(
    sourceKey, id, path, title, albumId, album, albumArtist, albumArtistId,
    artists, artistIds, genres, genreIds, trackNumber, discNumber, durationMs, year,
    artworkPath, lastModified, hasMetadata, retention, quality, originVersion,
    downloadedAt, lastPlayedAt, stale, sizeBytes, favorite, playCount
) VALUES (
    ?, ?, ?, ?, ?, ?, ?, ?,
    ?, ?, ?, ?, ?, ?, ?, ?,
    ?, ?, ?, ?, ?, ?,
    ?, ?, ?, ?, ?, ?
);

deleteForSource:
DELETE FROM trackRow WHERE sourceKey = ?;

deleteByIds:
DELETE FROM trackRow WHERE sourceKey = ? AND id IN ?;
