<?xml version="1.0" encoding="utf-8"?>
<!--
    Cleartext HTTP is allowed globally because Jellyfin servers on local
    networks are commonly HTTP-only. Restrict this if you ever distribute
    a release build to untrusted environments.
-->
<network-security-config>
    <!-- tools:ignore: cleartext is intentional — Jellyfin servers on local networks are often HTTP-only. -->
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration"
        xmlns:tools="http://schemas.android.com/tools">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
